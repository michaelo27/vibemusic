# ─────────────────────────────────────────────────────────────
# VibeMusic frontend (Next.js on Cloudflare Pages)
# ─────────────────────────────────────────────────────────────

# URL of your deployed Cloudflare Worker (no trailing slash).
# LOCAL DEV: http://localhost:8787
# PRODUCTION: https://vibemusic-relayer.<your-subdomain>.workers.dev
# If this is EMPTY the app runs in DEMO MODE (localStorage-backed, no chain
# writes, simulated agent) so you can click through the whole product instantly.
NEXT_PUBLIC_API_BASE=http://localhost:8787

# WalletConnect project id (free at https://cloudflare.com/? -> https://reown.com/cloud)
# Only needed for mobile wallet QR connections. Injected wallets work without it.
NEXT_PUBLIC_WC_PROJECT_ID=

# Base mainnet RPC used by the frontend (wagmi). The public endpoint is fine.
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Canonical URL, used for OG metadata (optional).
NEXT_PUBLIC_SITE_URL=https://vibemusic.pages.dev
